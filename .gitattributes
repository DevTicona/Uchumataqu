# Configuración automática de finales de línea
* text=auto

# Archivos de código C# (forzar normalización)
*.cs text diff=csharp
# Archivos de Unity que deben tratarse como texto/metadatos
*.meta text
*.prefab text
*.mat text
*.anim text
*.controller text
# Archivos que deben tratarse como binarios para evitar corrupción
*.unity binary
*.asset binary
*.physicMaterial binary
*.guiskin binary
*.fontsettings binary
*.bin filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.JPEG filter=lfs diff=lfs merge=lfs -text
*.asset filter=lfs diff=lfs merge=lfs -text
*.anim filter=lfs diff=lfs merge=lfs -text
* !text !filter !merge !diff
