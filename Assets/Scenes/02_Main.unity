  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Assets.Scripts.Core.UI.Ayuda.GuiaPantalla
  identificador: main:PageAjustes:v2
  ayuda: {fileID: 1299874637}
  pasos:
  - identificador: 
    titulo: Hazla tuya
    texto: "Edita tu perfil y ajusta el audio y la vibraci\xF3n desde esta pantalla."
    objetivo: {fileID: 0}
    nombreObjetivo: BtnEditarBadge
  - identificador: 
    titulo: Desactiva el volumen
    texto: "Arrastra el control de volumen completamente hacia la izquierda para
      silenciar todos los sonidos. Mu\xE9velo a la derecha para volver a escucharlos."
    objetivo: {fileID: 0}
    nombreObjetivo: SliderVolumen
  - identificador: 
    titulo: "Audio autom\xE1tico"
    texto: "Desactiva este interruptor para evitar que los ejemplos se reproduzcan
      autom\xE1ticamente. Puedes seguir escuch\xE1ndolos con sus botones de audio."
    objetivo: {fileID: 0}
    nombreObjetivo: ToggleAudioAutomatico
  - identificador: 
    titulo: "Desactiva la vibraci\xF3n"
    texto: "Toca este interruptor para desactivar la vibraci\xF3n. Puedes activarla
      nuevamente cuando quieras. Los cambios se guardan autom\xE1ticamente."
    objetivo: {fileID: 0}
    nombreObjetivo: ToggleVibracion
